# Copy to .env (cp .env.example .env) and fill in. .env is never committed.
# v1 on GitHub uses repository Secrets instead (Settings → Secrets and variables → Actions).

ANTHROPIC_API_KEY=

# Telegram: create a bot with @BotFather, press Start in your bot, send it "hi", then run
#   python -m radar telegram-id      (or: docker compose run --rm radar python -m radar telegram-id)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# v2 only: your Telegram user id. The bot ignores everyone else. In a private chat it equals the chat id,
# so you can leave it empty.
TELEGRAM_OWNER_ID=

# Email digest (Gmail app password, not your normal password). Leave empty to get the digest on Telegram only.
EMAIL_USER=abdulsalamjamiu770@gmail.com
EMAIL_APP_PASSWORD=
# EMAIL_TO=another@address.com   (optional; defaults to EMAIL_USER)

# v2 on the VPS (Docker): run the container as your VPS user so it can write ./data.
# Get the numbers with:  id -u   and   id -g
RADAR_UID=1000
RADAR_GID=1000

# Optional: off-server copy of the nightly backups (see deploy/backup.sh), e.g. gdrive:money-radar-backups
BACKUP_REMOTE=
